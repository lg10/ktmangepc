{
  "name": "kt-mange-pc",
  "private": true,
  "version": "3.0.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "build:release": "TAURI_SIGNING_PRIVATE_KEY=\"$(cat src-tauri/keys/kt-mange-pc.key)\" tauri build",
    "build:release:mac": "TAURI_SIGNING_PRIVATE_KEY=\"$(cat src-tauri/keys/kt-mange-pc.key)\" tauri build --target aarch64-apple-darwin && TAURI_SIGNING_PRIVATE_KEY=\"$(cat src-tauri/keys/kt-mange-pc.key)\" tauri build --target x86_64-apple-darwin",
    "build:release:mac:signed": "bash scripts/build-mac-signed.sh",
    "prepare:cdn": "node scripts/prepare-cdn.js"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.5.0",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-shell": "^2.2.0",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-vue-next": "^0.474.0",
    "pinia": "^2.3.1",
    "qrcode": "^1.5.4",
    "reka-ui": "^2.2.0",
    "tailwind-merge": "^3.0.2",
    "tw-animate-css": "^1.2.5",
    "vue": "^3.5.13",
    "vue-i18n": "^10.0.5",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.4",
    "@tauri-apps/cli": "^2.5.0",
    "@types/node": "^22.10.7",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^5.2.1",
    "tailwindcss": "^4.1.4",
    "typescript": "~5.6.3",
    "vite": "^6.0.7",
    "vue-tsc": "^2.2.0"
  }
}
